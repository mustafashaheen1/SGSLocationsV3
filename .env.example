# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site Configuration
# This base URL is used for constructing full property URLs in admin panel
# Change this when deploying to production domain (e.g., https://sgslocations.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@sgslocations.com
SENDGRID_FROM_NAME=SGS Locations

# SmugMug Configuration (optional)
SMUGMUG_API_KEY=your_smugmug_api_key
SMUGMUG_API_SECRET=your_smugmug_api_secret
SMUGMUG_USER_TOKEN=your_smugmug_user_token
SMUGMUG_USER_SECRET=your_smugmug_user_secret

# Google Maps API (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Anthropic API (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google reCAPTCHA v2 (for Contact and Register pages)
# Get your keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
